font_family      Cartograph CF
bold_font        Cartograph CF Bold
italic_font      Cartograph CF Fixed Italic
bold_italic_font Cartograph CF Fixed Bold Italic

font_size 10.0



cursor                  #BBB6B6
cursor_text_color       background

cursor_shape block

cursor_shape_unfocused hollow

url_color               #8da3b9
url_style straight

visual_bell_color       #B66467
bell_border_color       #B66467


single_window_padding_width 30


active_border_color     #B66467
inactive_border_color   #151515



foreground              #121212
background              #ffffff
selection_foreground    #e8e8e8
selection_background    #3E3E3E

# black  (bg3/bg4)
color0 #151515
color8 #424242

# red
color1 #B66467
color9 #B66467

#: green
color2 #8C977D
color10 #8C977D

# yellow
color3 #D9BC8C
color11 #D9BC8C

# blue
color4 #8DA3B9
color12 #8DA3B9

# purple
color5 #A988B0
color13 #A988B0

# cyan
color6 #8AA6A2
color14 #8AA6A2

# white (fg4/fg3)
color7 #E8E3E3
color15 #E8E3E3

map Alt+w       copy_to_clipboard

map Ctrl+y       paste_from_clipboard
