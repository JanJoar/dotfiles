[global]
    monitor = 0
    follow = mouse
    offset = (30, 60)
    indicate_hidden = yes
    shrink = no
    transparency = 0
    separator_height = 2
    padding = 16
    horizontal_padding = 16
    frame_width = 1
    frame_color = "#cfcfcf"
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = Cartograph CF 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = yes
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 0
    max_icon_size = 32
    icon_path = /usr/share/icons/gnome/16x16/status:/usr/share/icons/gnome/16x16/devices

    # Text colors
    foreground = "#000000"
    background = "fffffff"

    # Keybindings
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+shift+h
    context = ctrl+shift+period

[urgency_low]
    # Green for low urgency
    background = "#ffffff"
    foreground = "#000000"
    timeout = 10

[urgency_normal]
    # Blue for normal urgency
    background = "#ffffff"
    foreground = "#000000"
    timeout = 13

[urgency_critical]
    # Red/Magenta for critical urgency
    background = "#ffffff"
    foreground = "#a60000"
    timeout = 0
